<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	直装版（Developer ID 分发）专用 entitlements：不含 App Sandbox。
	沙盒与 Accessibility / CGEvent 事件投递不兼容，会导致模拟 ⌘C 取词在真实用户机器上静默失效。
	App Store 版使用 TLKit.entitlements（含沙盒）。
	-->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
